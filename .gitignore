# Terraform working directory
.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files (keep the example template tracked)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Private keys
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
!id_rsa*.pub
!id_ed25519*.pub
!id_ecdsa*.pub
!id_dsa*.pub

# Environment files
.env*

# Editor and OS files
.vscode/
.DS_Store
